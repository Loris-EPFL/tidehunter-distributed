{
  "uid": "kv-comparison-local",
  "title": "Local distributed KV comparison",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "kv-research",
    "local-only"
  ],
  "description": "Local shared-SSD observations. Raw samples + manifest define comparison validity. Observer must move OFF the measured controller for future cluster claims.",
  "templating": {
    "list": [
      {
        "name": "backend",
        "label": "Backend",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "kv-comparison-prometheus"
        },
        "query": "label_values(kv_comparison_completed_total, backend)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "phase",
        "label": "Phase (never pool phases)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "kv-comparison-prometheus"
        },
        "query": "label_values(kv_comparison_completed_total, phase)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Current run state (not scrape health)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "description": "no_run/waiting/stale/invalid contain NO workload samples. completed/failed preserve real final data; failed is never success.",
      "targets": [
        {
          "refId": "A",
          "expr": "kv_observer_state",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          },
          "instant": true
        },
        {
          "refId": "B",
          "expr": "kv_observer_data_available",
          "legendFormat": "actual data available",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          },
          "instant": true
        },
        {
          "refId": "C",
          "expr": "kv_observer_snapshot_final",
          "legendFormat": "final snapshot (0/1)",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "kv_comparison_current_phase",
          "legendFormat": "phase (1 qualification,2 preload,3 warmup,4 aging,5 measurement,6 drain)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Producer snapshot age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "description": "Final snapshots remain valid historical evidence as age rises. A stale running snapshot is removed, not re-timestamped as live data.",
      "targets": [
        {
          "refId": "A",
          "expr": "kv_observer_snapshot_age_seconds",
          "legendFormat": "producer snapshot age",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "API latency: dispatch \u2192 materialized result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "Cumulative current-run/phase bucket quantiles, not average p99s or per-key batch latency. Raw samples are authoritative. Failures/timeouts keep their own outcomes. Rejected arrivals have no API distribution.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,backend,operation,outcome,phase) (kv_comparison_api_latency_seconds_bucket{backend=~\"$backend\",phase=~\"$phase\"}))",
          "legendFormat": "p50 {{backend}} {{operation}} {{outcome}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,backend,operation,outcome,phase) (kv_comparison_api_latency_seconds_bucket{backend=~\"$backend\",phase=~\"$phase\"}))",
          "legendFormat": "p95 {{backend}} {{operation}} {{outcome}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le,backend,operation,outcome,phase) (kv_comparison_api_latency_seconds_bucket{backend=~\"$backend\",phase=~\"$phase\"}))",
          "legendFormat": "p99 {{backend}} {{operation}} {{outcome}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Response latency: scheduled arrival \u2192 completion",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "Cumulative current-run/phase bucket quantiles, not average p99s or per-key batch latency. Raw samples are authoritative. Failures/timeouts keep their own outcomes. Rejected arrivals have no API distribution.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,backend,operation,outcome,phase) (kv_comparison_response_latency_seconds_bucket{backend=~\"$backend\",phase=~\"$phase\"}))",
          "legendFormat": "p50 {{backend}} {{operation}} {{outcome}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,backend,operation,outcome,phase) (kv_comparison_response_latency_seconds_bucket{backend=~\"$backend\",phase=~\"$phase\"}))",
          "legendFormat": "p95 {{backend}} {{operation}} {{outcome}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le,backend,operation,outcome,phase) (kv_comparison_response_latency_seconds_bucket{backend=~\"$backend\",phase=~\"$phase\"}))",
          "legendFormat": "p99 {{backend}} {{operation}} {{outcome}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Scheduling delay: scheduled arrival \u2192 dispatch",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "Not network time. Admission rejection does not magically become a successful fast request.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le,backend,operation,outcome,phase) (kv_comparison_scheduling_delay_seconds_bucket{backend=~\"$backend\",phase=~\"$phase\"}))",
          "legendFormat": "p99 {{backend}} {{operation}} {{outcome}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Observed offered vs completed arrivals / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "Scraped counter rate, not configured target or whole-run exact throughput. Short runs may lack two scrapes; final frozen counters yield zero interval rate, not zero run throughput.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend,phase) (rate(kv_comparison_offered_total{backend=~\"$backend\",phase=~\"$phase\"}[$__rate_interval]))",
          "legendFormat": "offered {{backend}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (backend,phase) (rate(kv_comparison_completed_total{backend=~\"$backend\",phase=~\"$phase\"}[$__rate_interval]))",
          "legendFormat": "completed {{backend}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Actual run counts and outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "description": "Keep successes, timeouts, unknown mutation outcomes and errors separate. Counts are preserved for final snapshots, including sub-scrape-length runs.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend,operation,outcome,phase) (kv_comparison_completed_total{backend=~\"$backend\",phase=~\"$phase\"})",
          "legendFormat": "{{backend}} {{operation}} {{outcome}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (backend,operation,phase) (kv_comparison_rejected_total{backend=~\"$backend\",phase=~\"$phase\"})",
          "legendFormat": "rejected {{backend}} {{operation}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Timeout / error / rejected arrivals",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "description": "Do not divide away missing/failed work. No absent family is replaced with a fabricated zero.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend,operation,phase) (kv_comparison_timeout_total{backend=~\"$backend\",phase=~\"$phase\"})",
          "legendFormat": "timeout {{backend}} {{operation}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (backend,operation,phase) (kv_comparison_error_total{backend=~\"$backend\",phase=~\"$phase\"})",
          "legendFormat": "error {{backend}} {{operation}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (backend,operation,phase) (kv_comparison_rejected_total{backend=~\"$backend\",phase=~\"$phase\"})",
          "legendFormat": "rejected {{backend}} {{operation}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Batch key work (not per-key latency)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "description": "One get_many/write_batch call is one API sample. Key counts reveal group size; API latency is not divided by batch32.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend,operation,phase) (kv_comparison_keys_completed_total{backend=~\"$backend\",phase=~\"$phase\"})",
          "legendFormat": "completed keys {{backend}} {{operation}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Native WAL written and mapped bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "description": "Native names preserve their source types. wal_written_bytes is a GAUGE; never rate() it. These are not device durability or replicated HA proof.",
      "targets": [
        {
          "refId": "A",
          "expr": "wal_written_bytes{job=~\"comparison|native-benchmark\"}",
          "legendFormat": "written gauge {{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "wal_mmap_bytes{job=~\"comparison|native-benchmark\"}",
          "legendFormat": "mapped {{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Native WAL frontiers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "description": "Raw positions, not rates or byte counts. Native Value-WAL frontiers are not distributed transaction, quorum or Sui publication frontiers.",
      "targets": [
        {
          "refId": "A",
          "expr": "wal_synced_position{job=~\"comparison|native-benchmark\"}",
          "legendFormat": "synced {{job}} {{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "wal_last_processed_position{job=~\"comparison|native-benchmark\"}",
          "legendFormat": "processed {{job}} {{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "Native cache and read observations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "description": "Native payload-accounting gauges in bytes: value_cache_size counts retained key/full-key/value payload lengths, not allocator/RSS overhead. Missing series remain unavailable.",
      "targets": [
        {
          "refId": "A",
          "expr": "value_cache_size{job=~\"comparison|native-benchmark\"}",
          "legendFormat": "cache size {{job}} ks={{ks}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "decompress_cache_bytes{job=~\"comparison|native-benchmark\"}",
          "legendFormat": "decompressed bytes {{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Native cumulative reads and decompression hits",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "description": "Cumulative native counters; no claim that cache hits or submitted WAL reads equal physical NVMe IO.",
      "targets": [
        {
          "refId": "A",
          "expr": "read{job=~\"comparison|native-benchmark\"}",
          "legendFormat": "reads {{job}} {{ks}} {{kind}} {{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "read_decompress_cache_hits{job=~\"comparison|native-benchmark\"}",
          "legendFormat": "decompression hits {{job}} {{ks}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "Optional Sui typed-store snapshot (mixed gauges)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kv-comparison-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "description": "Source family is a mixed gauge vector: cumulative event totals, bytes, occupancy, limits and timing sums coexist under stat. Raw values only; do NOT apply rate() to the entire family. Sui checkpoint/transaction timing is not generic KV API timing.",
      "targets": [
        {
          "refId": "A",
          "expr": "tidehunter_adapter{job=\"sui-typed-store\"}",
          "legendFormat": "{{namespace}} {{stat}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kv-comparison-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "title": "Host CPU busy fraction",
