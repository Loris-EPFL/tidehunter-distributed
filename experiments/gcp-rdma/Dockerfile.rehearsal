FROM tidehunter-gcp-build:latest
# The real guest runs its own interpreter, a venv with the system packages and
# the pinned PyYAML wheel. The rehearsal image reproduces exactly that, so every
# binary and module the rehearsal runs is the same glibc 2.34 environment.
RUN python3 -m venv --system-site-packages /opt/tidehunter-python && \
    /opt/tidehunter-python/bin/python3 -m pip install --no-cache-dir 'pyyaml==6.0.2' && \
    /opt/tidehunter-python/bin/python3 -c \
      'import sys, yaml; assert yaml.__version__ == "6.0.2"; assert sys.executable == "/opt/tidehunter-python/bin/python3"'
