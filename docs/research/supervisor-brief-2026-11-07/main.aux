\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces RDMA over TCP, API p50 ratio for 80 Tidehunter pairs (verbs over TCP) and 43 Valkey pairs (RDMA over TCP), grouped by workload family. A pair has the same cohort, profile, value size, concurrency, operation, key count and offered rate. Red diamonds: the two Tidehunter paths differ by more than 0.1 device reads per call. The grey band is the range of the twin-run p50 ratios.}}{11}{figure.caption.18}\protected@file@percent }
\newlabel{fig:coherence}{{11}{11}{RDMA over TCP, API p50 ratio for \N {S:th_pairs} Tidehunter pairs (verbs over TCP) and \N {S:vk_pairs} Valkey pairs (RDMA over TCP), grouped by workload family. A pair has the same cohort, profile, value size, concurrency, operation, key count and offered rate. Red diamonds: the two Tidehunter paths differ by more than 0.1 device reads per call. The grey band is the range of the twin-run p50 ratios}{figure.caption.18}{}}
