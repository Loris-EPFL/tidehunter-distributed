\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Hit ratio $h=(L-g)/(L-H)$ that the coordinator cache needs for a mean read latency $g$. $L$ is the measured p50 of the miss path and $H=0.8$~$\mu $s\ the measured hit p50. This is an estimate from medians. Miss tails raise the real mean, so the ratios are lower bounds.}}{10}{table.caption.15}\protected@file@percent }
\newlabel{tab:hit}{{7}{10}{Hit ratio $h=(L-g)/(L-H)$ that the coordinator cache needs for a mean read latency $g$. $L$ is the measured p50 of the miss path and $H=0.8$~\us \ the measured hit p50. This is an estimate from medians. Miss tails raise the real mean, so the ratios are lower bounds}{table.caption.15}{}}
