\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Sealed repeat-pass scalar reads at concurrency 1 (8,192 calls per case): API p50/p99 in $\mu $s. Native, the owner RPC and the kernel target read memory. The SPDK target reads its SSD on every call (Table~\ref {tab:media}). One repetition.}}{7}{table.caption.10}\protected@file@percent }
\newlabel{tab:readcost}{{5}{7}{Sealed repeat-pass scalar reads at concurrency 1 (8,192 calls per case): API p50/p99 in \us . Native, the owner RPC and the kernel target read memory. The SPDK target reads its SSD on every call (Table~\ref {tab:media}). One repetition}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Sealed first-touch scalar reads at concurrency 1 ($n=8{,}192$ per case). p50 and p99 are API latencies in $\mu $s. B/call is the initiator\textquoteright s read volume per call and $\times $ its ratio to the value size. cmd is the mean block-layer time of one NVMe read at the initiator. dev/call is device reads per call on the owner hosts and dev the mean block-layer time of one such read.}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:nvmecmd}{{6}{7}{Sealed first-touch scalar reads at concurrency 1 ($n=8{,}192$ per case). p50 and p99 are API latencies in \us . B/call is the initiator\textquoteright s read volume per call and $\times $ its ratio to the value size. cmd is the mean block-layer time of one NVMe read at the initiator. dev/call is device reads per call on the owner hosts and dev the mean block-layer time of one such read}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Sealed scalar reads, first-touch (cache drop and key sweep) and repeat, at concurrency 1 and 16 (8,192 calls per case): API p50 (solid) and p99 (dashed). One repetition. The media state differs between paths (Table~\ref {tab:media}), so the transports are not compared here. Native is local.}}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:sealed}{{6}{8}{Sealed scalar reads, first-touch (cache drop and key sweep) and repeat, at concurrency 1 and 16 (8,192 calls per case): API p50 (solid) and p99 (dashed). One repetition. The media state differs between paths (Table~\ref {tab:media}), so the transports are not compared here. Native is local}{figure.caption.12}{}}
