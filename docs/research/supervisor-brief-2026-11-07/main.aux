\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces RF1 calls at concurrency 16: scalar reads (8,192 calls per case), scalar puts (4,096), 32-key reads and 32-key writes (2,048 calls per case; one call covers 32 values). API p50, API p99 and successful calls/s against value size. Tidehunter and Native: one run; other stores: median of 2 to 6 runs. Valkey has no batch-write case. Valkey TCP 32-key p99 includes stalls of 203~ms at 8~KiB and 213~ms at 64~KiB. Hollow SPDK markers: API latency kept, target counters not admitted. The Tidehunter coordinator cache is disabled. Owner and kernel-target page caches serve these reads (Table~\ref {tab:media}); the SPDK path reads the SSD. Valkey GET reads RAM.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:primary}{{3}{5}{RF1 calls at concurrency 16: scalar reads (8,192 calls per case), scalar puts (4,096), 32-key reads and 32-key writes (2,048 calls per case; one call covers 32 values). API p50, API p99 and successful calls/s against value size. \runs . Valkey has no batch-write case. Valkey TCP 32-key p99 includes stalls of \MR {p99ms}{valkey_tcp}{8192}~ms at 8~KiB and \MR {p99ms}{valkey_tcp}{65536}~ms at 64~KiB. Hollow SPDK markers: API latency kept, target counters not admitted. The Tidehunter coordinator cache is disabled. Owner and kernel-target page caches serve these reads (Table~\ref {tab:media}); the SPDK path reads the SSD. Valkey GET reads RAM}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Concurrency-1 mixed point operations: API p50 and p99 of reads and puts that run interleaved. Tidehunter and Native: one run; other stores: median of 2 to 6 runs. SPDK reads include an SSD read on every call (Table~\ref {tab:media}).}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:point}{{4}{6}{Concurrency-1 mixed point operations: API p50 and p99 of reads and puts that run interleaved. \runs . SPDK reads include an SSD read on every call (Table~\ref {tab:media})}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces All stores at 1~KiB, concurrency 16: API p50 (dot) and p99 (cross), sorted by p50. In the put panel a hollow dot marks a store whose device fsync was not verified (Cassandra, FoundationDB, TiKV).}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:others}{{5}{6}{All stores at 1~KiB, concurrency 16: API p50 (dot) and p99 (cross), sorted by p50. In the put panel a hollow dot marks a store whose device fsync was not verified (Cassandra, FoundationDB, TiKV)}{figure.caption.7}{}}
