\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Warm owner reads: mean/p50/p99 API latency ($\mu $s{}). One real row per arm/repetition; all four matched cells. Full arm names/security/polling are in the arm table. NR means not recorded, never zero. Coordinator cache off; lanes one at c1, four at c16; r0/r1 separate. Busy spins owner and coordinator read driver, not kernel busy poll. Unmatched dimensions: TLS/security, polling, RPC/direct I/O; NVMe control is verbs trusted Adaptive.}}{17}{table.caption.26}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Matched ratios, not isolated timers}{18}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Matched mean ratios, with numerator/denominator named. TLS uses adaptive TCP; like-for-like transport uses trusted TCP and verbs under the same policy; parking compares Adaptive with Busy within one trusted transport. Size, readers and repetition never change within a ratio.}}{18}{figure.caption.27}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Ratios of matched per-case means, A/B: TLS = TCP mTLS/TCP trusted (adaptive); transport = trusted TCP/trusted verbs at the named policy; parking = adaptive/Busy for the named trusted transport. Ratios are not differences or isolated wire/crypto timers. No ratio for failed, unqualified, missing or unmatched partners. Coordinator cache off; lanes one at c1, four at c16; r0/r1 separate. Busy spins owner and coordinator read driver, not kernel busy poll. Unmatched dimensions: TLS/security, polling, RPC/direct I/O; NVMe control is verbs trusted Adaptive.}}{18}{table.caption.28}\protected@file@percent }
