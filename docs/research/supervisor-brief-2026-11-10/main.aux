\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Process cores against whole-call mean latency, by cell and configured arm. Circles/triangles denote client/owner; filled/open denote r0/r1. Missing CPU has no marker, not a zero. Security and both ends' polling policy remain part of the comparison.}}{19}{figure.caption.29}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Client/owner process cores; CQ idle-wait count. Cores = CPU seconds / elapsed host-gate seconds, not per-call attribution. TCP CQ = NR, not zero. NVMe kernel workers are outside the owner cgroup. CPU and CQ counts are evidence, not proof of policy. Coordinator cache off; lanes one at c1, four at c16; r0/r1 separate. Busy spins owner and coordinator read driver, not kernel busy poll. Unmatched dimensions: TLS/security, polling, RPC/direct I/O; NVMe control is verbs trusted Adaptive.}}{19}{table.caption.30}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Device-qualified cold reads and NVMe-oF}{20}{subsection.6.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Cold whole-call means: owner RPC versus direct namespace paths. Labels annotate device reads per successful call in r0/r1 order; U and an absent latency marker retain an unqualified case. Kernel targets use direct backing I/O; SPDK uses file AIO; all use the kernel initiator. The NVMe-oF control channel is verbs trusted Adaptive, including NVMe/TCP.}}{20}{figure.caption.31}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Each cell: qualified mean API latency ($\mu $s{}); device reads per successful call. Completed cold rows require the qualified media receipt and ratio >=0.9; NVMe-oF also requires path and sealed-accounting qualification. Unqualified latency remains unavailable; its device ratio/reasons remain in the CSV. Counts do not prove every call reached NAND. Owner RPC is buffered/exact-range; namespace controls use kernel direct or SPDK file AIO and a kernel initiator. Coordinator cache off; lanes one at c1, four at c16; r0/r1 separate. Busy spins owner and coordinator read driver, not kernel busy poll. Unmatched dimensions: TLS/security, polling, RPC/direct I/O; NVMe control is verbs trusted Adaptive.}}{20}{table.caption.32}\protected@file@percent }
